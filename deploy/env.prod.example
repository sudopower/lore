# Copy to /opt/lore/.env.prod on the server and fill in. Never commit the filled-in file.

# Postgres password for the lore user. Pick a long random value: openssl rand -hex 16
POSTGRES_PASSWORD=

# Admin bearer token (tenant and key management). Generate with: openssl rand -hex 24
LORE_ADMIN_TOKEN=

# Model provider for ask. anthropic needs the key below; lore exits at startup without it.
LORE_LLM=anthropic
ANTHROPIC_API_KEY=

# Optional. The defaults are in the README Configuration table; uncomment to change.
# LORE_FAST_MODEL=
# LORE_FAST_EFFORT=
# LORE_DEEP_MODEL=
# LORE_DEEP_EFFORT=
# LORE_DEEP_DAILY_LIMIT=
# Hosts the MCP endpoint accepts, for example lore.example.com. Unset accepts any host,
# which is right behind Caddy.
# LORE_MCP_ALLOWED_HOSTS=
